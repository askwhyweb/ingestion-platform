# Copy to .env before running locally.

COMPOSE_PROJECT_NAME=ingestion-platform

VECTOR_IMAGE=timberio/vector:latest-debian
VECTOR_HTTP_PORT=8080
VECTOR_TCP_PORT=9002
VECTOR_SYSLOG_PORT=5514
# Local HTTP ingestion bearer token. Replace this in .env before sharing the endpoint.
VECTOR_HTTP_TOKEN=change-me-local-token
VECTOR_MAX_EVENT_BYTES=1048576

KAFKA_IMAGE=apache/kafka:4.1.0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=19092
KAFKA_TOPIC_RAW=logs.raw
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_TOPIC_SEGMENT_BYTES=268435456
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.1
OPENSEARCH_DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.19.1
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
OPENSEARCH_MEM_LIMIT=2g
OPENSEARCH_INITIAL_ADMIN_PASSWORD=local-Admin-Password-123!
OPENSEARCH_LOGS_RETENTION_DAYS=14
OPENSEARCH_INVALID_RETENTION_DAYS=7

MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
LOGS_ARCHIVE_BUCKET=logs-archive-local
DIAGNOSTICS_BUCKET=diagnostics-local
INVALID_LOGS_BUCKET=invalid-logs-local

STRESS_RATE=100
STRESS_DURATION=30
STRESS_SERVICES=checkout,orders,inventory
STRESS_MODULES=api,worker,connector,cron
STRESS_SEVERITY_MIX=debug:5,info:70,warn:15,error:8,fatal:2
STRESS_MESSAGE_SIZE=256
STRESS_DIAGNOSTICS=false
